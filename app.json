{
  "expo": {
    "name": "Hestia",
    "slug": "hestia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Hestia.png",
    "scheme": "boo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/Hestia.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.Hestia.app"
    },
    "android": {
      "package": "com.Hestia.app",
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/Hestia.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "603eadea-cef3-46eb-acb9-bcc1f2d5bade"
      }
    }
  }
}
